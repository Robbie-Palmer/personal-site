# Per-host local configuration; never commit real values
hosts/mac-mini/jellyfin/.env
hosts/mac-mini/media-automation/.env

# Runtime state that exists only on the hub (Jellyfin config, metadata, cache)
hosts/mac-mini/jellyfin/data/
hosts/mac-mini/media-automation/data/

# Ansible runtime state and optional local overrides
ansible/.facts/
ansible/inventory/host_vars/
ansible/inventory/group_vars/*/local.yml

# Local Kubernetes client credentials fetched from a commissioned cluster
.kube/
