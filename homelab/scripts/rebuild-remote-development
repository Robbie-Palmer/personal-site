#!/usr/bin/env bash
set -euo pipefail

target=${REMOTE_DEVELOPMENT_TAILNET_TARGET:-root@remote-development}
identity_file=${REMOTE_DEVELOPMENT_IDENTITY_FILE:-${HOME}/.ssh/id_ed25519}
nix_image="nixos/nix@sha256:c7cc6c8cb5d81bed19997247629604708fda95c99c43ac362daa05b6a68e8a24"
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
homelab_dir=$(cd -- "${script_dir}/.." && pwd)

if [ ! -r "${identity_file}" ]; then
  echo "cannot read SSH identity ${identity_file}" >&2
  exit 1
fi

docker run --rm \
  --network host \
  -e "NIX_CONFIG=experimental-features = nix-command flakes" \
  -e "NIX_SSHOPTS=-i /run/remote-development-identity -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no" \
  -v personal-site-nix-store:/nix \
  -v "${homelab_dir}:/workspace" \
  -v "${identity_file}:/run/remote-development-identity:ro" \
  -w /workspace \
  "${nix_image}" \
  nix run .#nixosConfigurations.remote-development.config.system.build.nixos-rebuild -- \
    switch \
    --flake .#remote-development \
    --target-host "${target}"

if [ "${REMOTE_DEVELOPMENT_SKIP_HEALTH:-0}" = 1 ]; then
  echo "skipped post-rebuild health check during commissioning"
else
  "${script_dir}/remote-development-health"
fi
