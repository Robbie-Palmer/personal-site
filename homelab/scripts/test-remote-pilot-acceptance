#!/usr/bin/env bash
set -euo pipefail

expected_context=${REMOTE_DEVELOPMENT_KUBE_CONTEXT:-remote-development}
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
marker="workspace-acceptance-$(date +%s)-${RANDOM}"

"${script_dir}/require-kube-context" "${expected_context}" cloud

for namespace in t3-code t3-code-pilot; do
  kubectl --namespace "${namespace}" rollout status deployment/t3-code --timeout=120s
done

cleanup() {
  for namespace in t3-code t3-code-pilot; do
    kubectl --namespace "${namespace}" exec deployment/t3-code -- \
      rm -f "/data/workspaces/${marker}-${namespace}" >/dev/null 2>&1 || true
  done
}
trap cleanup EXIT

for namespace in t3-code t3-code-pilot; do
  kubectl --namespace "${namespace}" exec deployment/t3-code -- \
    sh -eu -c 'printf "%s\n" "$1" >"/data/workspaces/$1"' sh "${marker}-${namespace}"
done

kubectl --namespace t3-code exec deployment/t3-code -- \
  test ! -e "/data/workspaces/${marker}-t3-code-pilot"
kubectl --namespace t3-code-pilot exec deployment/t3-code -- \
  test ! -e "/data/workspaces/${marker}-t3-code"

assert_service_blocked() {
  local source_namespace=$1
  local target_namespace=$2
  local target="t3-code.${target_namespace}.svc.cluster.local"

  kubectl --namespace "${source_namespace}" exec deployment/t3-code -- \
    getent hosts "${target}" >/dev/null
  if kubectl --namespace "${source_namespace}" exec deployment/t3-code -- \
    curl --silent --show-error --output /dev/null --connect-timeout 2 \
      "http://${target}:3773/" 2>/dev/null; then
    echo "${source_namespace} reached the ${target_namespace} workspace service" >&2
    exit 1
  fi
}

assert_service_blocked t3-code t3-code-pilot
assert_service_blocked t3-code-pilot t3-code

pilot_pod=$(kubectl --namespace t3-code-pilot get pod \
  --selector=app.kubernetes.io/name=t3-code \
  --output=jsonpath='{.items[0].metadata.name}')
kubectl --namespace t3-code-pilot delete pod "${pilot_pod}" --wait=true
kubectl --namespace t3-code-pilot rollout status deployment/t3-code --timeout=120s
kubectl --namespace t3-code-pilot exec deployment/t3-code -- \
  test -f "/data/workspaces/${marker}-t3-code-pilot"

echo "workspace file, service, and restart isolation checks passed"
