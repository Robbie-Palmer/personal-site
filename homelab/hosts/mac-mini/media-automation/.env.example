# Media automation stack (Prowlarr + Sonarr + Radarr + qBittorrent).
# Copy to .env and adjust before running //media:bootstrap.

# Where the Jellyfin library lives. Sonarr/Radarr import finished downloads
# straight into TV/ and Movies/ here.
MEDIA_DIR=/Volumes/Expansion/Media

# Where qBittorrent saves in-progress downloads. Keep it on the same volume
# as MEDIA_DIR so imports stay fast.
DOWNLOADS_DIR=/Volumes/Expansion/Downloads

TZ=UTC

# File ownership for the linuxserver.io images (matches the hub admin user).
PUID=501
PGID=20

PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878
QBITTORRENT_PORT=8080

# Image tags; leave as latest unless pinning deliberately.
PROWLARR_VERSION=2.5.2.5491-ls156
SONARR_VERSION=4.0.19.2979-ls322
RADARR_VERSION=6.3.0.10514-ls313
QBITTORRENT_VERSION=libtorrentv1

# Recyclarr publishes no latest tag; pin the major version.
RECYCLARR_VERSION=8.7.1

# Generated by bootstrap.sh on first run (qBittorrent WebUI login "admin").
QBITTORRENT_PASSWORD=
