{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "exclude": ["exports", "types", "nsExports", "nsTypes", "enumMembers"],
  "ignoreBinaries": ["mise", "typecheck", "wrangler", "duckdb", "flux-schema", "uv"],
  "workspaces": {
    ".": {
      "entry": [
        "functions/**/*.ts",
        "api-governance/spectral-functions/*.js",
        "cpp/autonomic-satellite-swarm/browser/tests/browser_parity.mjs",
        "cpp/autonomic-satellite-swarm/scripts/*.ts",
        "homelab/images/t3-code/bootstrap-settings.mjs",
        "homelab/tests/**/*.test.ts",
        "scripts/prose-lint.ts"
      ],
      "ignoreDependencies": ["lint-staged", "markdownlint-cli", "remark-cli", "remark-lint", "tsx", "yaml-lint"]
    },
    "ai-review": {
      "entry": [
        "tests/cloudflare-workers.ts",
        "tests-runtime/**/*.test.ts",
        "analytics/*.ts",
        "vitest.workerd.config.ts"
      ],
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/ai-review-domain": {},
    "packages/work-graph-domain": {
      "ignoreBinaries": ["vitest"]
    },
    "packages/writing-editor-domain": {},
    "ui": {
      "ignore": [
        "content/**",
        "public/recipes-sw.js",
        "public/simulations/autonomic-satellite-swarm/**/*.mjs"
      ],
      "ignoreDependencies": ["serve"]
    },
    "workers/recipe-api": {
      "entry": [
        "vitest.integration.config.ts",
        "scripts/**/*.ts"
      ],
      "ignoreDependencies": ["@stoplight/spectral-owasp-ruleset"]
    },
    "workers/recipe-ingest": {
      "ignoreDependencies": ["cloudflare"]
    },
    "ml-pipelines/recipe-dataset": {
      "entry": ["src/stages/*.mjs", "scripts/*.mjs"]
    },
    "ml-pipelines/recipe-parsing": {
      "entry": ["src/stages/*.ts"]
    },
    "ml-pipelines/ai-review-evaluation": {
      "entry": [
        "src/extract-corpus.ts",
        "src/freeze-cohort.ts",
        "src/run-replays.ts",
        "src/match-replays.ts",
        "src/build-scorecard.ts",
        "tests/*.test.ts"
      ]
    },
    "ml-pipelines/writing-editor-evaluation": {
      "entry": [
        "src/extract-dataset.ts",
        "src/freeze-cohort.ts",
        "tests/*.test.ts"
      ]
    }
  }
}
